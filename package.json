{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "recipe-saver",
  "title": "Recipe Saver",
  "description": "Queue a recipe URL with recipe-saver",
  "icon": "icon.png",
  "author": "tylerpaige",
  "license": "MIT",
  "commands": [
    {
      "name": "add-recipe",
      "title": "Add Recipe",
      "description": "Queue a recipe URL, with optional tags and a note",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "binaryPath",
      "title": "recipe-saver Path",
      "description": "Path to the recipe-saver executable",
      "type": "textfield",
      "required": false,
      "default": "~/bin/recipe-saver"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.5.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "lint": "ray lint"
  }
}
